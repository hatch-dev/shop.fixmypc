/*
 * Shared layout for the signed-in account pages.
 *
 * Dashboard, Profile, Address Book, Orders, Wishlist, Recently Viewed,
 * Vouchers and Savers Club each carried their own panel, table and button
 * rules, so the same element was a different size and colour depending on
 * which sidebar link you had clicked. These classes are the one definition;
 * a page that wants a panel uses .acc-panel rather than inventing another.
 *
 * Global rather than scoped because the markup lives in both pages and the
 * components they delegate to (UserAccountAddress, Vouchers), which cannot
 * share a scope id.
 */

// ---------------------------------------------------------------- layout

.acc-head
  display flex
  justify-content space-between
  align-items flex-start
  gap 16px
  flex-wrap wrap
  margin-bottom 24px

.acc-title
  color #130E2B
  font-size 22px
  font-weight 600
  margin 0 0 4px
  line-height 1.3

.acc-sub
  color #6B7280
  font-size 14px
  margin 0

.acc-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(260px, 1fr))
  gap 16px

.acc-grid-tiles
  grid-template-columns repeat(auto-fit, minmax(200px, 1fr))

.acc-grid-split
  grid-template-columns repeat(auto-fit, minmax(300px, 1fr))

.acc-panel
  background #fff
  border 1px solid #E3E3EF
  border-radius 14px
  padding 20px
  height 100%

.acc-panel-head
  display flex
  justify-content space-between
  align-items center
  gap 12px
  flex-wrap wrap
  margin-bottom 16px

.acc-panel-title
  font-size 17px
  font-weight 600
  color #130E2B
  margin 0

// ---------------------------------------------------------------- tables

.acc-table-scroll
  overflow-x auto
  -webkit-overflow-scrolling touch

.acc-table
  width 100%
  border-collapse collapse
  min-width 560px

  th
    background #F5F5FF
    font-size 13px
    font-weight 600
    color #130E2B
    padding 11px 12px
    text-align left
    white-space nowrap

    &:first-child
      border-radius 8px 0 0 8px

    &:last-child
      border-radius 0 8px 8px 0

  td
    font-size 14px
    color #130E2B
    padding 14px 12px
    border-bottom 1px solid #F0F0F6
    vertical-align middle

  tbody tr:last-child td
    border-bottom 0

  tbody tr:hover
    background #FAFAFF

// ---------------------------------------------------------------- badges

.acc-status
  display inline-block
  font-size 12px
  font-weight 500
  padding 4px 10px
  border-radius 999px
  text-transform capitalize
  white-space nowrap

.acc-status-progress
  background #EBEBFF
  color #33319A

.acc-status-done
  background #D4EDDA
  color #1E7E34

.acc-status-stopped
  background #FDECEA
  color #C82333

// ---------------------------------------------------------------- buttons

.acc-btn
  display inline-flex
  align-items center
  justify-content center
  height 38px
  padding 0 16px
  border-radius 8px
  font-size 13px
  font-weight 500
  cursor pointer
  text-decoration none
  white-space nowrap
  transition background-color .15s ease, color .15s ease, border-color .15s ease

.acc-btn-primary
  background #05B942
  color #fff
  border 1px solid #05B942

  &:hover:enabled,
  &:hover
    background #049636
    border-color #049636
    color #fff

.acc-btn-ghost
  background #fff
  color #171717
  border 1px solid #E3E3EF

  &:hover:enabled,
  &:hover
    background #F5F5FF
    border-color #33319A
    color #33319A

.acc-btn:disabled
  opacity .55
  cursor not-allowed

.acc-link
  color #33319A
  font-size 14px
  font-weight 500
  text-decoration none
  display inline-flex
  align-items center
  gap 6px

  &:hover
    text-decoration underline

// ---------------------------------------------------------------- empty

.acc-empty
  text-align center
  padding 40px 20px
  color #6B7280

  i
    display block
    font-size 28px
    color #C7C7D9
    margin-bottom 12px

  p
    font-size 14px
    margin 0 0 16px

.acc-empty-sm
  padding 24px 16px

// ---------------------------------------------------------------- phones

@media (max-width 767px)

  .acc-title
    font-size 19px

  .acc-panel
    padding 16px

  /*
   * Wide tables cannot fit on a phone, and scrolling sideways hides the
   * columns that matter. Each row becomes a card, with the column heading
   * taken from the cell's data-label.
   */
  .acc-table.acc-table-stack
    min-width 0

    thead
      position absolute
      width 1px
      height 1px
      overflow hidden
      clip rect(0, 0, 0, 0)

    &, tbody, tr, td
      display block
      width 100%

    tr
      border 1px solid #E3E3EF
      border-radius 10px
      padding 6px 12px
      margin-bottom 12px

      &:last-child
        margin-bottom 0

    td
      display flex
      justify-content space-between
      align-items center
      gap 12px
      padding 9px 0
      border-bottom 1px solid #F0F0F6
      text-align right

      &:last-child
        border-bottom 0

      &::before
        content attr(data-label)
        font-size 12px
        font-weight 600
        color #6B7280
        text-align left
        flex-shrink 0
