@import "variables.styl"

.header
  background #fff
  padding 10px 0
  padding-bottom 20px
  border-bottom 1px solid #ECECF9

.logo
  img
    height 65px

// Right Section
.header-right
  display flex
  flex-direction column
  align-items center

// Search
.search-wrap
  background #fff
  border 1px solid #e3e3ef
  border-radius 50px
  padding 0px 10px
  display flex
  align-items center
  width 650px
  position relative

  select,
  input
    border none
    outline none
    font-size 14px

  input
    flex 1
    height 42px

.search-btn
  width 36px
  height 36px
  background #5a4bff
  border-radius 50%
  color #fff
  line-height 0px
  border none

// Icons
.icon-box
  width 50px
  height 40px
  border-radius 50%
  display flex
  align-items center
  justify-content center
  background #F4F4FB

// Nav
.nav-links
  a
    margin-right 15px
    text-decoration none
    color #130E2B
    font-size 14px
    font-weight 500

.badge-hot
  background #33319A
  color #fff
  padding 5px 15px
  border-radius 100px
  font-size 14px
  font-weight 500

.badge-green
  background #05B942
  color #fff
  padding 5px 15px
  border-radius 100px
  font-size 14px
  font-weight 500

.small-info
  font-size 13px
  color #666

select.header-serach
  border 1px solid #E3E3EF
  border-radius 50px
  padding 9px 16px
  width 39%

span.contact
  color #130E2B
  font-size 14px
  font-weight 500

span.nw_img
  margin-left 5px

