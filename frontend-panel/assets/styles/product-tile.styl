@import "variables.styl"

.discover-area
  width 100%

.p-tile > .page-link
  display block

.discount
  background home-bg
  color primary-color
  padding 1px 4px
  font-size .75em
  font-weight 600
  border-radius 4px

.p-tile
  position relative
  z-index 0
  transition all .1s
  cursor pointer
  border-radius border-radius

  &:hover
    .img-wrapper
      & > .compare-btn
        opacity 1
        transform translateX(0)


  .img-wrapper
    position relative


    .badge
    & > .compare-btn
      position absolute
      top 0
      z-index 1


    & > .compare-btn
      right 5px
      opacity 0
      transform translateX(20px)
      transition all .2s

      i
        &.close-icon
          transform scale(.7)

    .badge
      left 5px
      font-size .7em
      padding 2px 5px
      color #fff
      border-radius 3px
      background primary-color

    .fav-btn
      position absolute
      top 10px
      right 10px
      height auto
      font-size 2em
      z-index 10
      line-height 1
      color #666

      span
        line-height 1

.p-tile
  & > .page-link
    display block

.user-compared
.user-wishlists
  .tile-container
    .p-tile
      min-width 25%
      width 25%

.tile-container
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 24px

  @media(max-width:1200px)
    grid-template-columns repeat(3, 1fr)

  @media(max-width:768px)
    grid-template-columns repeat(2, 1fr)

  @media(max-width:480px)
    grid-template-columns 1fr

  //.p-tile
    //width 16.66%
   // min-width 16.66%
  //  margin-bottom 15px

//RESPONSIVE
@media only screen and (max-width: 1400px)
  .tile-container
    .p-tile
      min-width 20%
      width 20%

@media only screen and (max-width: 1200px)
  .tile-container
    .p-tile
      width 25%
      min-width 25%

@media only screen and (max-width: 992px)
  .user-compared .tile-container
  .user-wishlists .tile-container
  .tile-container
    .p-tile
      width 33.33%
      min-width 33.33%

@media only screen and (max-width: 768px)
  .p-tile .img-wrapper > .compare-btn
    transform none
    opacity 1

  .p-tile
    .img-wrapper
      img
        padding 10px

  .user-compared  .tile-container
  .user-wishlists  .tile-container
  .tile-container
    .p-tile
      width 50%
      min-width 50%


@media only screen and (max-width: 576px)
  .tile-container
    margin 0 -5px

    .p-tile
      padding 0 5px
      width 50%
      min-width 50%
      margin-bottom 10px

// ==================== VAT LABELS ====================
// An unlabelled price is ambiguous here: most of this catalogue is quoted
// inc-VAT and the business-facing lines are quoted ex-VAT with the tax added
// at checkout. The tile says which, and gives the other figure underneath so
// nobody has to work it out.
.price-vat-side
  margin-left 6px
  font-size 11px
  font-weight 600
  letter-spacing .02em
  text-transform uppercase
  color #737987
  white-space nowrap

.price-vat-alt
  margin 2px 0 0
  font-size 12px
  line-height 1.4
  color #737987
  display flex
  align-items baseline
  gap 4px
  flex-wrap wrap

// The quantity stepper is waiting on the server for this line's price. On a
// quantity band the pending figure is a different number, not a slightly stale
// one, so the tile says so instead of letting the old price pass as current.
.price-updating
  margin 2px 0 0
  font-size 12px
  line-height 1.4
  color #737987
  font-style italic

// The step was refused. The figures on screen still agree with each other, so
// this reads as "that did not happen", not "this price is wrong".
.price-error
  margin 2px 0 0
  font-size 12px
  line-height 1.4
  color #c0392b
  display flex
  align-items baseline
  gap 6px
  flex-wrap wrap

.price-retry
  background none
  border none
  padding 0
  font-size 12px
  font-weight 600
  color #2f3542
  text-decoration underline
  cursor pointer

  &:disabled
    opacity .5
    cursor default

// The bracketed VAT detail after the gross figure: "(VAT 23% €160.77)".
// Quieter than the figure it qualifies, and kept whole when the line wraps on
// a narrow tile - the rate and the amount belong together.
.price-vat-amount
  white-space nowrap
  color #9096a5
