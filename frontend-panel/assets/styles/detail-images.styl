@import "variables.styl";

.scroller-at-left
  display block !important

.zoomer-base-container
  text-align center

.drift-bounding-box
  z-index 10

.detail-image
  position relative
  width auto

  .thumb-list
    justify-content center
    margin 5px 0 10px
    align-items center

    .zoomer-control
      transform rotate(-90deg)

  .arrow-hide
    .thumb-list
      & > .zoomer-control
        display none

  .pleceholder-zoomer-base-container
  .zoomer-base-container
    cursor pointer
    width 100% !important
    position static !important

    & > img
      width auto
      height 400px
      width 100%
      object-fit contain
      padding 20px
      
   


  .pleceholder-thumb-list
    margin 0 -5px
  .pleceholder-thumb-list
  .thumb-list
    width auto !important
    grid-row-gap 0 !important
    height auto !important
    display flex !important
    justify-content center

    .responsive-image
      height 70px !important
      width 70px !important
      margin 5px
      padding 10px
      border-radius border-radius
      border 1px solid #ddd
      object-fit contain

    .zoomer-control.responsive-image
      height 30px !important
      width 30px !important
      border none
      opacity .3

      &:hover
        opacity .6

    .choosed-thumb
      box-shadow 0 0 2px 1px primary-color !important

// The zoom preview. 500px is only the fallback width: ProductImages sizes
// it to the whole product-info column on hover (sizeZoomPane), so the text
// beside it can no longer show through. A solid card, so it reads as a
// preview laid over the page rather than a hole in it.
.pane-container
  top 0 !important
  height 500px !important
  width 500px !important
  left calc(100% + 15px) !important
  border-radius 12px
  z-index 1000
  overflow hidden
  background #fff
  border 1px solid #E4E5F0
  box-shadow 0 12px 32px rgba(19, 14, 43, .14)

.rtl .drift-zoom-pane img
  left 0

// Right-to-left: the column, and so the preview, is on the image's left.
.rtl .pane-container
  right calc(100% + 15px) !important
  left auto !important

//RESPONSIVE
@media only screen and (max-width: 768px)
  .detail-image
    padding-left 0
