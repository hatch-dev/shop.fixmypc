.social-share
  align-items center

  .share-link-btn
    display inline-flex
    align-items center
    gap 8px
    height auto
    line-height 1.3
    padding 0
    border-radius 0
    font-size inherit
    font-weight 600
    color inherit
    background none

    &:hover
    &:focus-visible
      color primary-color

    &:active
      background none
      box-shadow none

    &:disabled
      opacity .7
      cursor default

  .share-link-icon
    width 30px
    min-width 30px
    height 30px
    color primary-color

//RESPONSIVE
@media only screen and (max-width: 768px)
  .social-share
    display flex
    flex-direction column
    justify-content left
    align-items stretch
    font-size 1.1em

    & > .share-link-btn
      gap 10px
      display flex
      padding 5px 0
      width 100%
