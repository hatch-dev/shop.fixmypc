APP_NAME=Ishop

#For local
APP_URL=
CLIENT_BASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

##Stoprage setting. [GCS/LOCAL/URL]
MEDIA_STORAGE=LOCAL

#If you want to use main image instead of thumb image, put THUMB_PREFIX empty
THUMB_PREFIX=thumb-

#If you want to use image URL, put the URL here
DEFAULT_IMAGE=default-image.webp

##Image base URL. Dont forget to add "/" at the end
CDN_URL=

##Google Cloud Storage Config
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
GOOGLE_CLOUD_KEY_FILE=service-account.json

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Public host for images inside emails. Leave blank to use APP_URL.
# Set it when APP_URL is a local or internal address, otherwise every
# <img> in an email points somewhere the recipient cannot reach.
MAIL_ASSET_URL=

BREVO_API_KEY=

#For local
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SHARED_SERVER_CONFIGURED=false

APP_ENV=local
APP_KEY=base64:UlY5jTmkmu33a0JFp6rfXDIkoA3Oa/LMyUnAKIJO9GM=
APP_DEBUG=true

#Language
DEFAULT_LANG=en
FALLBACK_LANG=en


ORDER_DETAIL_REDIRECT="${CLIENT_BASE_URL}/user/order"
FRONTEND_SOCIAL_REDIRECT="${CLIENT_BASE_URL}/social-callback"
BACKEND_SOCIAL_REDIRECT="${APP_URL}/api/v1/user/social-login/callback"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# 'database', not 'sync'. On 'sync' there is no queue at all: every order email
# is sent inside the customer's request, so a slow SMTP handshake is added to
# the checkout response and a refused connection is the end of that email --
# no retry, no record, nothing to replay. Requires the jobs/failed_jobs tables
# and a cron running `php artisan schedule:run` every minute.
QUEUE_CONNECTION=database

# The named queue order mail rides on, so a backlog of some other job type
# cannot sit in front of a receipt. Must match the --queue in App\Console\Kernel,
# which reads this same value.
MAIL_ORDER_QUEUE=emails
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


LICENCE_SERVER=https://verify.ishop.web-zed.com

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_SMS_FROM=
SMS_DEFAULT_DIAL_CODE=
TWILIO_TRIAL_TEMPLATE=false

# The approved WhatsApp Content Template procurement requests are sent as.
# WhatsApp refuses free-form text for a business-initiated conversation
# (Twilio error 21654), so without this a supplier is never messaged.
# The template must declare four placeholders, in this order:
#   {{1}} order number  {{2}} item count  {{3}} items  {{4}} bid link
TWILIO_WHATSAPP_CONTENT_SID=

# Where the supplier bid link points. The storefront, not the API.
# Leave empty when they are the same host: it falls back to APP_URL.
PROCUREMENT_LINK_BASE=

# How suppliers are asked to quote: email | whatsapp | both.
# WhatsApp needs an APPROVED Content Template (see above), so email is the
# default -- it needs no approval and the supplier record already has the address.
PROCUREMENT_CHANNEL=email
# AfterShip Tracking API (shipment tracking). Server-side only: never put
# these in admin-panel/.env or frontend-panel/.env, which are built into JS.
# Key: AfterShip admin > Settings > API keys. Secret: Settings > Webhooks,
# with the webhook pointed at https://<site>/api/v1/aftership/webhook.
AFTERSHIP_API_KEY=
AFTERSHIP_API_VERSION=2026-07
AFTERSHIP_WEBHOOK_SECRET=
# Move an order to Delivered on the courier's delivered scan (default true).
AFTERSHIP_AUTO_DELIVER=true
# AfterShip's simulated "testing-courier"; defaults to on outside production.
# AFTERSHIP_ALLOW_TEST_COURIER=false
# Minutes between status checks per parcel; empty = 720 with a webhook secret, 60 without.
AFTERSHIP_SYNC_MINUTES=
# Separate key for the customer's signed tracking link (empty = APP_KEY).
AFTERSHIP_LINK_SECRET=
