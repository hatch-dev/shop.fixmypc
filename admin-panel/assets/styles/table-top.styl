@import "./variables.styl"

.table-top
  margin 0 0 12px

  .grow
    gap 10px
    align-items center

  .button.primary-btn
    height 36px
    line-height 36px

.bulk-action > button
  gap 5px
  display flex
  border-radius var(--radius-md)
  align-items center
  padding-left 12px
  padding-right 12px
  height 36px
  line-height 34px

.bulk-action > button i
  margin-top -3px
  opacity .6

.bulk-action.inline-pop-wrapper .inline-pop-over
  min-width 180px
  padding 5px

.bulk-action .pop-content .outline-btn
  height 34px
  line-height 34px
  background none
  border 0
  width 100%
  text-align left

