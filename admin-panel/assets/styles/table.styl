@import "./variables.styl"

table.single-table
  th
    border-radius 0!important

.rtl
  table
    th
      &:first-child
        padding-right 14px

table tr.new-data
  background new-record-color

table
  width 100%
  border-collapse separate
  border-spacing 0
  table-layout auto
  background surface-color

  tr
    transition background .12s ease

    &:hover:not(.lite-bold)
      background hover-color

    &:last-child
      td
        border-bottom 0

    .status
      span
        padding 3px 8px
        border-radius 999px
        font-size 11px
        line-height 18px
        font-weight 650
        color danger-foreground
        text-transform capitalize
        background danger-bg-color

    .active
      span
        color success-foreground
        background success-bg-color

    .info
      span
        color info-foreground
        background info-bg-color

  th
    position sticky
    top 0
    z-index 1
    font-weight 650
    font-size 12px
    line-height 18px
    text-align center
    white-space nowrap
    color var(--text-muted)
    background #FAFBFC
    padding 8px 10px
    border-bottom 1px solid border-color

    &:first-child
      padding-left 14px

    &:last-child
      padding-right 14px

  td
    text-align center
    padding 7px 10px
    border-bottom 1px solid border-color
    color font-color
    font-size 13px
    line-height 20px
    vertical-align middle

    .dply-felx.j-left.link
      margin -5px 0
      justify-content center

    &:first-child
      padding-left 14px

    &:last-child
      padding-right 14px

    h5
      font-size 13px
      font-weight 600
      line-height 18px
      overflow hidden
      text-overflow ellipsis
      display -webkit-box
      -webkit-line-clamp 2
      -webkit-box-orient vertical

    img
      height auto
      width 100px
      border-radius 6px
      object-fit cover

    .button
    button
      margin 2px
      height 30px
      line-height 28px
      padding 0 10px
      border-radius var(--radius-sm)
      font-size 12px

.table-wrapper
  background surface-color
  border 1px solid border-color
  border-radius var(--radius-lg)
  overflow auto
  box-shadow none

.tr-border
  tr:last-child
    td
      border-bottom none!important

@media only screen and (max-width: 768px)
  table
    th
      padding 8px

    td
      padding 8px
