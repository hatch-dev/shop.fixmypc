@import "variables.styl"

.location-wrap .custom-dropdown .dropdown-inner
  max-height 300px

.dropdown-inner::-webkit-scrollbar-track
  background-color rgba(0, 0, 0, .1)

.dropdown-inner::-webkit-scrollbar-track
  background-color #eee

.dropdown-inner::-webkit-scrollbar
  width 8px

.dropdown-inner::-webkit-scrollbar-thumb
  background-color rgba(0, 0, 0, .15)
  border-radius 40px

.custom-dropdown + button > .undo-icon
  opacity .8
  transform scale(.8)

.custom-dropdown
  position relative
  display inline-block
  line-height 0
  max-width 180px

  .layer
    z-index 1

  & > span
    gap 10px
    display flex
    align-items center
    justify-content space-between
    cursor pointer
    user-select none
    padding 0 12px
    height 36px
    line-height 34px
    background surface-color
    border 1px solid border-strong
    border-radius var(--radius-md)
    font-size .9em
    min-width 80px
    white-space nowrap
    overflow hidden
    text-overflow ellipsis
    transition all .1s

    i
      opacity .5

    &:hover:not(.disabled)
      background hover-color !important
      border-color border-strong

    &:active:not(.disabled)
      box-shadow none

  .dropdown-inner
    position absolute
    top 100%
    left 0
    min-width 150px
    background surface-color
    padding 4px
    border 1px solid border-color
    border-radius var(--radius-md)
    box-shadow none
    z-index 3
    max-height 400px
    overflow auto

    & > input
      padding 0 10px
      border 1px solid border-color
      margin-bottom 5px

    ul
      max-height 340px

      li
        user-select none
        cursor pointer
        display block
        padding 7.5px 20px
        border-radius var(--radius-sm)
        transition all .1s
        margin 0

        &:hover
          background hover-color

      .active
        background var(--primary-soft)
        color primary-color

.right-dropdown.custom-dropdown
  .dropdown-inner
    left auto
    right 0

.open
  span
    border-color primary-color
    box-shadow none

//RESPONSIVE
@media only screen and (max-width: 992px)
  .custom-dropdown
    .dropdown-wrapper
      left auto
      right 0

@media only screen and (max-width: 768px)
  .custom-dropdown
    span
      height btn-height-sm
      line-height btn-height-sm

    .dropdown-wrapper
      position fixed
      top 0
      left 0 !important
      right 0 !important
      bottom 0
      z-index 10

      .layer
        top 0
        display block

      .dropdown-inner
        top 50%
        left 50%
        transform translate(-50%, -50%)

      ul
        max-height 60vh
        li
          padding 7.5px 15px

@media only screen and (max-width: 576px)
  .custom-dropdown
    span
      padding 0 10px 0 15px
