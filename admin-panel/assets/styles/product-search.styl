@import "variables.styl"
.search-dropdown
  position absolute
  left 0
  right 0
  top 100%
  background #fff
  overflow hidden
  border-radius 0 0 10px 10px
  border 1px solid #ddd
  border-top 0
  z-index 2
  box-shadow 0 5px 10px rgba(0,0,0, .15)
  display flex
  flex-direction column
  justify-content flex-end

  .suggestion-body
    position relative
    min-height 300px

    ul
      height 300px
      overflow auto
      li
        display block
        a
          border-bottom 1px solid #eee
          padding 15px 15px

          i
            margin-left 15px

        &:last-child
          a
            border-bottom none

  .suggestion-footer
    background #f7f8f9
    border-top 1px solid #eee

.deletable
  td
    position relative

    &.undo-container
      &:after
        z-index -1

    &:after
      content ''
      position absolute
      top 0
      bottom 0
      left 0
      right 0
      opacity 0
      z-index -1
      background #fff

  &.deleted
    td:not(.undo-container)
      &:after
        z-index 1
        opacity .6

/*
 * Optional per-row notes in the product picker.
 *
 * Only rendered when a parent passes ProductSearch a `notes` map; the pages
 * that do not (bundle deals, clearances, upsell source types) never produce
 * these elements, so none of this applies to them.
 */
.product-search
  .ps-name
    display flex
    flex-direction column
    gap 2px
    min-width 0

  .ps-note
    font-style normal
    font-size 11.5px
    line-height 1.3
    color var(--text-muted, #6B7280)

  /* Already in another flash sale: readable, but not pickable. */
  .ps-blocked
    cursor not-allowed

    h5
    .ps-note
      opacity .55

  .ps-taken
    flex-shrink 0
    white-space nowrap
    padding 2px 8px
    border-radius 999px
    font-size 11px
    line-height 18px
    font-weight 650
    color var(--warning-text, #7A5A00)
    background var(--warning-bg, #FFF7D6)
