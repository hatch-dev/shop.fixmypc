@import "./variables.styl"

.main
  background var(--shell-bg)
  min-height 100vh

  .content
    background var(--shell-bg)
    position relative
    margin-left sidebar-collapsed-width
    padding header-height + 12px 16px 18px
    transition margin .16s ease, padding .16s ease
    min-height 100vh
    height 100vh
    overflow-y auto
    box-shadow none

.sidebar-opened
  .content
    margin-left sidebar-width

.rtl
  .main
    .content
      margin-left 0
      margin-right sidebar-collapsed-width

  .sidebar-opened
    .content
      margin-left 0
      margin-right sidebar-width

@media only screen and (max-width: 1200px)
  .sidebar-opened
    .content
      margin-left sidebar-width-lg

  .rtl
    .sidebar-opened
      .content
        margin-right sidebar-width-lg

@media only screen and (max-width: 768px)
  .p-sm-15
    padding 15px !important

  .pl-sm-0
    padding-left 0 !important

  .main
    .content
      margin-left 0
      padding header-height-sm + 10px 10px 12px

  .sidebar-opened
    .content
      margin-left 0

  .rtl
    .main
      .content
        margin-right 0
        padding header-height-sm + 10px 10px 12px

    .sidebar-opened
      .content
        margin-right 0
