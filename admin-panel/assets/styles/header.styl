@import "variables.styl"

header
  left 0
  right 0
  top 0
  z-index 20
  display flex
  padding 0 12px 0 0
  position fixed
  background surface-color
  align-items center
  height header-height
  justify-content space-between
  border-bottom 1px solid border-color

  .logo-wrapper
    display flex
    align-items center
    justify-content space-between
    width sidebar-width
    flex-shrink 0

  .header-actions
    display flex
    align-items center
    gap 8px

  .expand-btn
    width 38px
    height 38px
    min-width 38px
    padding 0
    display flex
    align-items center
    justify-content center
    border 1px solid border-color
    background surface-color
    border-radius var(--radius-md)
    color var(--text-muted)
    box-shadow 0 1px 2px rgba(17,24,39,.04)
    transition all .2s ease

    i
      font-size 14px
      transition transform .25s ease

    &:hover
      background var(--primary-soft)
      border-color primary-color
      color primary-color

      i
        transform scale(1.12)

    &.active
      background var(--primary-soft)
      border-color primary-color
      color primary-color

  .header-brand
    display flex
    align-items center
    gap 10px
    min-width 0
    padding-left 14px
    font-size 13px
    font-weight 700
    color var(--text-strong)

    img
      width auto
      height 40px
      max-width 160px
      object-fit contain
      flex-shrink 0

    span
      line-height 1
      white-space nowrap

  .toggle-menu-btn
    width 38px
    height 38px
    min-width 38px
    margin-left 0
    padding 0
    display flex
    align-items center
    justify-content center
    border 1px solid border-color
    background surface-color
    border-radius var(--radius-md)
    box-shadow 0 1px 2px rgba(17,24,39,.04)
    transition all .2s ease
    color var(--text-muted)

    i
      font-size 15px
      transition transform .25s ease

    &:hover
      background var(--primary-soft)
      border-color primary-color
      color primary-color

    &.active
      background var(--primary-soft)
      border-color primary-color
      color primary-color

  i.icon
    transform scale(.82)

  .right-wrap
    padding 0
    justify-content flex-end
    min-width 0

  .right-wrap > .dply-felx
    gap 6px
    align-items center

  .lang-down
    min-width auto

    .icon
      opacity .65
      transform scale(1)

    span
      height 36px
      line-height 34px
      padding 0 10px
      background surface-color
      border 1px solid border-color
      border-radius var(--radius-md)

  .clear-cache
    min-width 115px

    span
      font-size .85rem

  .dots-btn
    display none
    padding 0
    width 38px
    min-width 38px
    height 38px
    border-radius var(--radius-md)

    i
      margin-right 0

  .right-area
    display flex

  button
    display flex
    gap 5px
    align-items center
    border none
    padding 0 10px

.sidebar-closed
  header
    .logo-wrapper
      width sidebar-collapsed-width
      justify-content center

    .header-brand
      span
        display inline-block

    .expand-btn
      display none

@media only screen and (max-width: 1200px)
  header
    .logo-wrapper
      min-width sidebar-width-lg

  .sidebar-closed
    header
      .logo-wrapper
        width sidebar-collapsed-width
        justify-content center

@media only screen and (max-width: 992px)
  .rtl header .right-wrap
    justify-content left

  header
    .right-wrap
      justify-content right

    button
      padding 0 5px

    .logo-wrapper
      flex 0 0 180px


    .header-brand span
      display none

@media only screen and (max-width: 768px)
  .rtl header .right-area
    left 0
    right auto

  .rtl header .right-area button
    padding-left 15px
    padding-right 15px

  header
    padding 0 12px
    // Keep the header (and its menu toggle) above the mobile drawer + overlay
    // so the hamburger can always open/close the sidebar.
    z-index 1003

    .logo-wrapper
      width auto
      flex 1
      min-width 0
      border-right 0

    .header-brand
      display none

    .header-actions
      margin-left auto

    .clear-cache
      display none

    .toggle-menu-btn
      height 40px
      width 40px
      min-width 40px

    .dots-btn
      display flex

      .icon
        height 28px
        width 28px
        min-width 28px

    .right-area
      position absolute
      top 100%
      right 0
      background surface-color
      z-index 1
      box-shadow 0 12px 28px shadow-color
      border 1px solid border-color
      border-radius var(--radius-md)
      display none
      padding 4px

      button
        padding-left 10px
        padding-right 20px
        width 100%
        border-radius var(--radius-sm)

  .dots-open
    .right-area
      display block

  .expand-btn,
  .toggle-menu-btn
    width 38px
    height 38px
    display flex
    align-items center
    justify-content center
    border none
    background transparent
    border-radius 10px
    transition .25s
    &:hover
      background #EEF2FF


@media only screen and (max-width:768px)

  header
    height header-height-sm
    padding 0 12px

    .logo-wrapper
      flex 1
      padding 0
      border-right none

    .header-brand

      img
        width auto
        height 28px
        max-width 120px

      span
        display none

    .header-actions
      gap 4px

    .expand-btn,
    .toggle-menu-btn
      width 36px
      height 36px
