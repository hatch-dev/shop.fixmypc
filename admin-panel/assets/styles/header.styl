@import "variables.styl"

header
  left 0
  right 0
  top 0
  z-index 20
  display flex
  padding 0 12px 0 0
  position fixed
  background surface-color
  align-items center
  height header-height
  justify-content space-between
  border-bottom 1px solid border-color

  .logo-wrapper
    display flex
    align-items center
    justify-content space-between
    width sidebar-width
    flex-shrink 0

  .header-actions
    display flex
    align-items center
    gap 8px

  .expand-btn
    width 38px
    height 38px
    min-width 38px
    padding 0
    display flex
    align-items center
    justify-content center
    border 1px solid border-color
    background surface-color
    border-radius var(--radius-md)
    color var(--text-muted)
    box-shadow 0 1px 2px rgba(17,24,39,.04)
    transition all .2s ease

    i
      font-size 14px
      transition transform .25s ease

    &:hover
      background var(--primary-soft)
      border-color primary-color
      color primary-color

      i
        transform scale(1.12)

    &.active
      background var(--primary-soft)
      border-color primary-color
      color primary-color

  .header-brand
    display flex
    align-items center
    gap 10px
    min-width 0
    padding-left 14px
    font-size 13px
    font-weight 700
    color var(--text-strong)

    img
      width auto
      height 40px
      max-width 160px
      object-fit contain
      flex-shrink 0

    span
      line-height 1
      white-space nowrap

  .toggle-menu-btn
    width 38px
    height 38px
    min-width 38px
    margin-left 0
    padding 0
    display flex
    align-items center
    justify-content center
    border 1px solid border-color
    background surface-color
    border-radius var(--radius-md)
    box-shadow 0 1px 2px rgba(17,24,39,.04)
    transition all .2s ease
    color var(--text-muted)

    i
      font-size 15px
      transition transform .25s ease

    &:hover
      background var(--primary-soft)
      border-color primary-color
      color primary-color

    &.active
      background var(--primary-soft)
      border-color primary-color
      color primary-color

  i.icon
    transform scale(.82)

  .right-wrap
    padding 0
    justify-content flex-end
    min-width 0

  .right-wrap > .dply-felx
    gap 6px
    align-items center

  .lang-down
    min-width auto

    .icon
      opacity .65
      transform scale(1)

    span
      height 36px
      line-height 34px
      padding 0 10px
      background surface-color
      border 1px solid border-color
      border-radius var(--radius-md)

  .clear-cache
    min-width 115px

    span
      font-size .85rem

  .dots-btn
    display none
    padding 0
    width 38px
    min-width 38px
    height 38px
    border-radius var(--radius-md)

    i
      margin-right 0

  .right-area
    display flex

  button
    display flex
    gap 5px
    align-items center
    border none
    padding 0 10px

// The logo column above the sidebar always has the sidebar's width, so the
// hamburger lines up with the menu under it:
//   > 1200px   open 248 (sidebar-width), collapsed 64 (sidebar-collapsed-width)
//   769-1200   open 232 (sidebar-width-lg, as the sidebar), collapsed 64
//   <= 768     the sidebar is an off-canvas drawer: the column shrinks to its
//              buttons on the start edge (left in English, right in Arabic)
// Below 1200px a min-width (and a 180px flex-basis below 992px) used to hold
// the collapsed column at 180-262px with the hamburger floating in it, and the
// open width lived in sidebar.styl, where it overrode these rules.
//
// Arabic (body.rtl): the build's PostCSS turns logical properties into
// left/right ones, so the few sided values are mirrored under .rtl here,
// next to the rule they mirror.
.rtl
  header
    padding 0 0 0 12px

    .header-brand
      padding-left 0
      padding-right 14px

.sidebar-opened
  header
    .logo-wrapper
      width sidebar-width

.sidebar-closed
  header
    .logo-wrapper
      width sidebar-collapsed-width
      justify-content center

    .header-brand
      span
        display inline-block

    .expand-btn
      display none

@media only screen and (max-width: 1200px)
  .sidebar-opened
    header
      .logo-wrapper
        width sidebar-width-lg

@media only screen and (max-width: 992px)
  header
    .right-wrap
      justify-content flex-end

    button
      padding 0 5px

    .header-brand span
      display none

@media only screen and (max-width: 768px)
  header
    height header-height-sm
    padding 0 12px
    // Keep the header (and its menu toggle) above the mobile drawer + overlay
    // so the hamburger can always open/close the sidebar.
    z-index 1003

    .header-brand
      display none

    .header-actions
      gap 4px

    .clear-cache
      display none

    .expand-btn
      width 36px
      height 36px

    .toggle-menu-btn
      height 40px
      width 40px
      min-width 40px

    .dots-btn
      display flex

      .icon
        height 28px
        width 28px
        min-width 28px

    .right-area
      position absolute
      top 100%
      right 0
      background surface-color
      z-index 1
      box-shadow 0 12px 28px shadow-color
      border 1px solid border-color
      border-radius var(--radius-md)
      display none
      padding 4px

      button
        padding-left 10px
        padding-right 20px
        width 100%
        border-radius var(--radius-sm)

  .rtl header
    padding 0 12px

    .right-area
      left 0
      right auto

      button
        padding-left 20px
        padding-right 10px

  // open or collapsed, the column is just its buttons at the start edge
  .sidebar-opened,
  .sidebar-closed
    header
      .logo-wrapper
        width auto
        flex 0 0 auto
        min-width 0
        padding 0
        justify-content flex-start

  .dots-open
    .right-area
      display block

  .expand-btn,
  .toggle-menu-btn
    display flex
    align-items center
    justify-content center
    border none
    background transparent
    border-radius 10px
    transition .25s
    &:hover
      background #EEF2FF
