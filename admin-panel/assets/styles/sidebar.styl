.sidebar
  width 290px
  height 100vh
  display flex
  flex-direction column
  background #fff
  border-right 1px solid #E5E7EB
  overflow hidden   // important

.sidebar_innr
  display flex
  flex-direction column

/* Logo */
.logo
  align-items center
  border-bottom 1px solid #f3f4f6
  display flex
  gap 10px
  padding 24px
  padding-top 80px

  span
    font-weight 700
    font-size 20px
    color #1F2937

  img
    width 40px
    height auto


/* Menu */
.menu
  flex 1
  padding 20px 0

.menu-controls
  padding 10px 15px
  border-bottom 1px solid #eee

.collapse-btn
  background none
  border none
  font-size 13px
  cursor pointer
  display flex
  align-items center
  gap 6px
  color #666

  &:hover
    color #000

.menu-section
  margin-bottom 35px
  padding 0 15px

.menu-section-title
  display: flex;
  align-items: center;
  padding 0 24px
  font-size 12px
  font-weight 600
  color #9CA3AF
  text-transform uppercase
  margin-bottom 12px
  letter-spacing 0.06em
  cursor pointer
  justify-content: space-between;


/* Menu Items */
.menu-item
  padding 10px 20px
  font-size 14px
  font-weight 500
  border-radius 16px
  line-height 20px
  color #1F2937
  display flex
  align-items center
  gap 12px
  cursor pointer
  transition all 0.2s ease
  background #FFF
  margin-bottom 5px

  &:hover
    background #F5F5F7

  i
    width 18px
    text-align center
    font-size 15px
    color #9CA3AF

  &.active
    background #111827
    color #ffffff

    i
      color #C1F25D


.menu-text
  flex 1

.menu-badge
  background #C1F25D
  color #000000
  font-size 10px
  font-weight 700
  padding 2px 8px
  border-radius 999px
  min-width 24px
  text-align center

.menu-item.ordr-incmplt
  span.menu-badge
    background #FEE2E2
    color #DC2626


/* User Section */
.user
  padding 18px 20px
  border-top 1px solid #E5E7EB
  background #F3F4F6
  display flex
  align-items center
  justify-content space-between

.user-left
  display flex
  align-items center
  gap 12px

.user-avatar
  position relative
  width 42px
  height 42px

  img
    width 100%
    height 100%
    border-radius 50%
    object-fit cover
    border 2px solid #fff
    box-shadow 0 1px 2px rgba(0,0,0,0.08)

.status-dot
  position absolute
  bottom -2px
  right -2px
  width 12px
  height 12px
  background #22C55E
  border 2px solid #fff
  border-radius 50%

.user-info
  font-size 14px
  font-weight 600
  color #111827

  span
    display block
    font-size 13px
    font-weight 400
    color #6B7280

.logout-icon
  background transparent
  border none
  cursor pointer
  width 36px
  height 36px
  display flex
  align-items center
  justify-content center
  border-radius 8px
  transition all .2s ease

  i
    font-size 16px
    color #6B7280

  &:hover
    background #E5E7EB