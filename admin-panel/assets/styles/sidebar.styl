@import "variables.styl"

.sidebar-overlay
  display none

.sidebar
  position fixed
  left 0
  top header-height
  bottom 0
  z-index 15
  width sidebar-collapsed-width
  display flex
  flex-direction column
  background #ffffff
  border-right 1px solid #E7EAF3
  box-shadow 6px 0 20px rgba(15,23,42,.05)
  transition width .16s ease
  overflow hidden

.rtl
  .sidebar
    left auto
    right 0
    border-right 0
    border-left 1px solid border-color

.sidebar_innr
  min-height 0
  flex 1
  display flex
  flex-direction column

.menu
  flex 1
  overflow-y auto
  overflow-x hidden
  padding 8px 8px 12px

.menu-section
  margin-bottom 4px

.menu-section-title
  display none

.expand-all-container
  display none

.section-items
  display flex
  flex-direction column
  gap 2px

.menu-item
  position relative
  width 100%
  min-height 40px
  padding 0 20px
  border-radius var(--radius-md)
  color font-color
  display flex
  align-items center
  justify-content center
  gap 10px
  cursor pointer
  transition background .14s ease, color .14s ease
  background transparent

  &:hover
    background hover-color

  i
    width 20px
    min-width 20px
    text-align center
    font-size 15px
    transition .25s
    color var(--text-muted)

  &.active
    background var(--primary-soft)
    color primary-color

    &:before
      content ''
      position absolute
      left -8px
      top 8px
      bottom 8px
      width 3px
      border-radius 0 4px 4px 0
      background primary-color

    i
      color primary-color

.rtl
  .menu-item.active:before
    left auto
    right -8px
    border-radius 4px 0 0 4px

.menu-text
  display none
  min-width 0
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.menu-badge
  display none

.user
  margin 6px
  padding 4px
  border-radius 14px
  background #F8FAFC
  border 1px solid #EEF2F7
  display flex
  align-items center
  justify-content center

.user-left
  display flex
  align-items center
  justify-content center
  max-width 100%

.user-avatar
  position relative
  flex-shrink 0
  width 36px
  height 36px

  img
    width 100%
    height 100%
    border-radius 50%
    object-fit cover
    border 1px solid border-color

.status-dot
  position absolute
  bottom 0
  right 0
  width 10px
  height 10px
  background success-foreground
  border 2px solid surface-color
  border-radius 50%

.user-info
.logout-icon
  display none

.sidebar-opened
  .logo
    display flex
    align-items center
    gap 14px
    padding 18px 18px 20px
    border-bottom 1px solid #eef2f7

    img
      width 44px
      height 44px
      border-radius 12px
      background #f7f8fb
      padding 6px

    span
      font-size 20px
      font-weight 700
      color #1e293b
      
  .sidebar
    width sidebar-width

  .menu
    padding 12px 12px 14px

  .menu-section
    margin-bottom 2px

  .menu-section-title
    display flex
    align-items center
    justify-content space-between

    cursor pointer

    padding 8px 12px
    margin-bottom 4px

    font-size 12px
    font-weight 700
    letter-spacing 1px
    text-transform uppercase

    color var(--text-strong)

    border-radius 10px

    transition .25s

    &:hover
      background #F8FAFC

  .expand-all-container
    display block
    padding 2px 0 8px

  .menu-item
    position relative

    min-height 36px

    border-radius 12px

    padding 0 14px

    margin-bottom 2px

    justify-content flex-start

    transition .25s

    color #000000

    font-size 12px

    font-weight 600

    &:hover
      background #EEF4FF
      color #4F46E5
      transform translateX(4px)

    i
      width 20px
      font-size 13px
      color #64748B

    &.active
      background linear-gradient(90deg,#EEF2FF,#F8FAFF)
      color #4338CA
      font-weight 600

      box-shadow 0 8px 18px rgba(79,70,229,.08)

      &:before
        left -10px
        width 4px
        background #4F46E5
        border-radius 4px

      i
        color #4F46E5

  .menu-text
    display block

  .menu-badge
    display inline-flex
    align-items center
    justify-content center
    background var(--primary-soft)
    color primary-color
    font-size 10px
    font-weight 700
    padding 2px 8px
    border-radius 999px
    min-width 24px

  .user
    justify-content space-between
    margin 10px 12px
    padding 10px 12px
    background var(--page-bg)

  .user-left
    min-width 0
    justify-content flex-start
    gap 10px

  .user-info
    display block
    min-width 0
    font-size 13px
    font-weight 650
    color var(--text-strong)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

    span
      display block
      font-size 12px
      font-weight 400
      color muted-color
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

  .logout-icon
    display flex
    align-items center
    justify-content center
    flex 0 0 auto
    width 38px
    height 38px

    border-radius 10px

    transition .25s

    &:hover
      background #EEF2FF

      i
        color #4F46E5

    &:hover
      background border-color

.sidebar-opened.rtl
  .menu-item.active:before
    right -12px

@media only screen and (max-width: 1200px)
  .sidebar-opened
    .sidebar
      width sidebar-width-lg

@media only screen and (max-width: 768px)
  .sidebar
    top header-height-sm
    width 0
    // Keep the mobile drawer above content-level popovers/dropdowns (z-index 1000)
    // so its items always receive taps while it is open.
    z-index 1002
    pointer-events auto
    box-shadow 12px 0 28px shadow-color

  .sidebar-opened
    .sidebar
      width sidebar-width-sm

    .sidebar-overlay
      display block
      position fixed
      top header-height-sm
      left 0
      right 0
      bottom 0
      z-index 1001
      background var(--overlay-color)

  .sidebar-closed
    .sidebar
      width 0
      // A zero-width drawer must not intercept taps on the content behind it.
      pointer-events none

.menu::-webkit-scrollbar
  width 7px

.menu::-webkit-scrollbar-thumb
  background #D4D7DD
  border-radius 50px

.menu::-webkit-scrollbar-thumb:hover
  background #AEB4BF

.toggle-icon
  font-size 11px
  width 20px
  height 20px
  display flex
  align-items center
  justify-content center
  border-radius 6px
  color var(--text-muted)
  transition transform .25s ease, background .2s ease, color .2s ease

.menu-section-title:hover .toggle-icon
  background var(--primary-soft)
  color primary-color

.toggle-icon.open
  transform rotate(90deg)
  color primary-color

.expand-all-btn
  height 38px

  border-radius 10px

  background #F8FAFC

  border 1px solid #E5E7EB

  transition .25s

  &:hover
    background #EEF2FF
    color #4F46E5

.sidebar-opened
  header
    .logo-wrapper
      width sidebar-width
      
