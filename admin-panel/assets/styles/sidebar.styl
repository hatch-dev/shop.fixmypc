@import "variables.styl"

.sidebar
  position fixed
  left 0
  top header-height
  bottom 0
  z-index 15
  width sidebar-collapsed-width
  display flex
  flex-direction column
  background surface-color
  border-right 1px solid border-color
  transition width .16s ease
  overflow hidden

.rtl
  .sidebar
    left auto
    right 0
    border-right 0
    border-left 1px solid border-color

.sidebar_innr
  min-height 0
  flex 1
  display flex
  flex-direction column

.logo
  display none

.menu
  flex 1
  overflow-y auto
  overflow-x hidden
  padding 8px 8px 12px

.menu-section
  margin-bottom 4px

.menu-section-title
  display none

.expand-all-container
  display none

.section-items
  display flex
  flex-direction column
  gap 2px

.menu-item
  position relative
  width 100%
  min-height 40px
  padding 0 20px
  border-radius var(--radius-md)
  color font-color
  display flex
  align-items center
  justify-content center
  gap 10px
  cursor pointer
  transition background .14s ease, color .14s ease
  background transparent

  &:hover
    background hover-color

  i
    width 20px
    min-width 20px
    text-align center
    font-size 15px
    color var(--text-muted)

  &.active
    background var(--primary-soft)
    color primary-color

    &:before
      content ''
      position absolute
      left -8px
      top 8px
      bottom 8px
      width 3px
      border-radius 0 4px 4px 0
      background primary-color

    i
      color primary-color

.rtl
  .menu-item.active:before
    left auto
    right -8px
    border-radius 4px 0 0 4px

.menu-text
  display none
  min-width 0
  flex 1
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.menu-badge
  display none

.user
  padding 8px
  border-top 1px solid border-color
  background surface-color
  display flex
  align-items center
  justify-content center
  gap 6px

.user-left
  display flex
  align-items center
  justify-content center

.user-avatar
  position relative
  width 36px
  height 36px

  img
    width 100%
    height 100%
    border-radius 50%
    object-fit cover
    border 1px solid border-color

.status-dot
  position absolute
  bottom 0
  right 0
  width 10px
  height 10px
  background success-foreground
  border 2px solid surface-color
  border-radius 50%

.user-info
.logout-icon
  display none

.sidebar-opened
  .sidebar
    width sidebar-width

  .menu
    padding 12px 12px 14px

  .menu-section
    margin-bottom 14px

  .menu-section-title
    display flex
    align-items center
    justify-content space-between
    height 26px
    padding 0 8px
    font-size 11px
    font-weight 650
    color var(--text-soft)
    text-transform uppercase
    letter-spacing 0
    cursor pointer

  .expand-all-container
    display block
    padding 2px 0 8px

  .menu-item
    justify-content flex-start
    min-height 34px
    padding 7px 10px
    font-size 13px
    font-weight 500

    i
      font-size 14px

    &.active
      background var(--primary-soft)
      font-weight 650

      &:before
        left -12px
        top 7px
        bottom 7px

  .menu-text
    display block

  .menu-badge
    display inline-flex
    align-items center
    justify-content center
    background var(--primary-soft)
    color primary-color
    font-size 10px
    font-weight 700
    padding 2px 8px
    border-radius 999px
    min-width 24px

  .user
    justify-content space-between
    padding 10px 12px
    background var(--page-bg)

  .user-left
    min-width 0
    justify-content flex-start
    gap 10px

  .user-info
    display block
    min-width 0
    font-size 13px
    font-weight 650
    color var(--text-strong)
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

    span
      display block
      font-size 12px
      font-weight 400
      color muted-color
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

  .logout-icon
    display flex
    align-items center
    justify-content center
    width 34px
    min-width 34px
    height 34px
    padding 0
    background transparent
    border 0
    border-radius var(--radius-md)

    i
      color muted-color

    &:hover
      background border-color

.sidebar-opened.rtl
  .menu-item.active:before
    right -12px

@media only screen and (max-width: 1200px)
  .sidebar-opened
    .sidebar
      width sidebar-width-lg

@media only screen and (max-width: 768px)
  .sidebar
    top header-height-sm
    width 0
    box-shadow 12px 0 28px shadow-color

  .sidebar-opened
    .sidebar
      width sidebar-width-sm

  .sidebar-closed
    .sidebar
      width 0
