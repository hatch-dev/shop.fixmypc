/*
 *  Cross-sell: the tab on a product, its picker, and the overview screen.
 *
 *  Built from the same tokens, radii and spacing as upsell.styl and the rest
 *  of the admin, so the two recommendation screens read as one feature rather
 *  than as two that happened to land in the same panel.
 */

.xs-manager
  display flex
  flex-direction column
  gap 14px

.xs-head
  display flex
  align-items flex-start
  justify-content space-between
  flex-wrap wrap
  gap 12px

.xs-title
  margin 0 0 4px
  font-size 15px
  font-weight 700

.xs-hint
  margin 0
  font-size 12.5px
  line-height 1.55
  color var(--text-muted, #6B7280)

.xs-add-btn
  flex 0 0 auto

  &:disabled
    opacity .55
    cursor not-allowed

.xs-notice
  padding 14px 16px
  font-size 13px
  border 1px dashed var(--border-color, #E9E9F4)
  border-radius var(--radius-md, 10px)
  color var(--text-muted, #6B7280)

.xs-empty-state
  padding 28px 20px
  text-align center
  border 1px dashed var(--border-color, #E9E9F4)
  border-radius var(--radius-md, 10px)

  p
    margin 0 0 6px
    font-size 14px
    font-weight 600

  small
    display block
    max-width 460px
    margin 0 auto
    font-size 12.5px
    line-height 1.6
    color var(--text-muted, #6B7280)

// ---- the configured table ----------------------------------------------

.xs-table
  overflow-x auto
  border 1px solid var(--border-color, #E9E9F4)
  border-radius var(--radius-md, 10px)

  table
    width 100%
    min-width 680px
    border-collapse collapse

  th, td
    padding 10px 12px
    font-size 12.5px
    text-align left
    vertical-align middle
    border-bottom 1px solid var(--border-color, #E9E9F4)

  th
    font-weight 700
    white-space nowrap

  tr:last-child td
    border-bottom 0

  /*
   *  A switched-off row is dimmed; a row that is on but cannot currently show
   *  is NOT. The second one is a problem the admin may want to fix, and
   *  fading it is how it stops being noticed.
   */
  tr.is-off
    opacity .55

  tr.is-blocked
    background rgba(214, 158, 46, .07)

.xs-picker-name
  display flex
  align-items center
  gap 10px

  strong
    display block
    font-size 13px
    line-height 1.3

  small
    display block
    font-size 11.5px
    color var(--text-muted, #6B7280)

.xs-thumb
  flex 0 0 auto
  width 42px
  height 42px
  object-fit cover
  border-radius var(--radius-sm, 6px)
  background var(--muted-bg, #F4F4F9)

.xs-small
  font-size 12.5px
  color var(--text-muted, #6B7280)

.drag-handle
  cursor grab
  user-select none
  font-size 15px
  color var(--text-muted, #9CA3AF)

  &:active
    cursor grabbing

// ---- badges -------------------------------------------------------------

.xs-badge
  display inline-block
  padding 3px 9px
  font-size 11.5px
  font-weight 600
  line-height 1.5
  border-radius 999px
  background var(--muted-bg, #F1F1F7)
  color var(--text-muted, #6B7280)
  border 1px solid transparent

  &.live
    background rgba(5, 185, 66, .11)
    color #1E8A45

  &.off
    background rgba(107, 114, 128, .12)
    color #6B7280

  /* On, but nothing a shopper can see -- worth its own colour. */
  &.blocked
    background rgba(214, 158, 46, .15)
    color #9A6B12

  &.taken
    background rgba(51, 49, 153, .1)
    color #333199

  &.is-toggle
    cursor pointer

    &:disabled
      cursor not-allowed
      opacity .6

.xs-foot-note
  margin 0
  font-size 12px
  color var(--text-muted, #6B7280)

// ---- the picker ---------------------------------------------------------

.xs-picker-pop
  .pop-over-inner
    width min(960px, 94vw)

  .pop-over-content
    max-height 62vh
    overflow-y auto

.xs-picker-bar
  display flex
  flex-wrap wrap
  gap 8px
  margin 12px 0

  input[type="text"]
    flex 1 1 240px

  input[type="text"], select
    height 36px
    padding 0 12px
    font-size 13px
    border 1px solid var(--border-color, #E9E9F4)
    border-radius var(--radius-sm, 6px)
    background var(--card-bg, #fff)
    color inherit

.xs-picker-table
  overflow-x auto
  border 1px solid var(--border-color, #E9E9F4)
  border-radius var(--radius-md, 10px)

  table
    width 100%
    min-width 760px
    border-collapse collapse

  th, td
    padding 10px 12px
    font-size 12.5px
    text-align left
    vertical-align middle
    border-bottom 1px solid var(--border-color, #E9E9F4)

  th
    font-weight 700
    white-space nowrap

  tr:last-child td
    border-bottom 0

  tr.is-picked
    background rgba(51, 49, 153, .05)

  tr.is-taken
    opacity .6

.xs-picker-more
  margin-top 10px
  text-align center

.xs-picker-foot
  display flex
  align-items center
  gap 10px
  width 100%

.xs-picker-count
  font-size 12.5px
  font-weight 600
  color var(--text-muted, #6B7280)

.xs-spacer
  flex 1 1 auto

.xs-empty
  padding 22px
  font-size 13px
  text-align center
  color var(--text-muted, #6B7280)

// ---- the overview screen ------------------------------------------------

.xs-limit-card
  display flex
  align-items center
  justify-content space-between
  flex-wrap wrap
  gap 14px
  padding 18px 20px
  margin 0 15px 4px

.xs-limit-field
  display flex
  align-items center
  gap 8px

  input
    width 84px
    height 36px
    padding 0 10px
    font-size 13px
    border 1px solid var(--border-color, #E9E9F4)
    border-radius var(--radius-sm, 6px)
    background var(--card-bg, #fff)
    color inherit

.xs-overview
  padding 18px 20px
  margin 0 15px

.xs-overview-bar
  margin-bottom 12px

  input
    width min(360px, 100%)
    height 36px
    padding 0 12px
    font-size 13px
    border 1px solid var(--border-color, #E9E9F4)
    border-radius var(--radius-sm, 6px)
    background var(--card-bg, #fff)
    color inherit

// ---- phone --------------------------------------------------------------

@media (max-width: 767px)
  .xs-head
    flex-direction column
    align-items stretch

  .xs-add-btn
    width 100%

  .xs-limit-card
    flex-direction column
    align-items stretch

  .xs-picker-foot
    flex-wrap wrap

    .xs-spacer
      display none

    .xs-picker-count
      width 100%

// ---- Promotions -> Cross-sell: list, form, view -------------------------

.xs-list-name
  display block
  font-size 13.5px
  font-weight 600

.xs-list-desc
  display block
  margin-top 2px
  font-size 12px
  color var(--text-muted, #6B7280)

.xs-form
  display flex
  flex-direction column
  gap 18px
  padding 20px
  margin 0 15px

.xs-form-grid
  display grid
  grid-template-columns 2fr 1fr
  gap 16px

  .input-wrapper
    margin 0

.xs-form-actions
  display flex
  justify-content flex-end
  gap 10px
  padding-top 6px
  border-top 1px solid var(--border-color, #E9E9F4)

.xs-view-meta
  display flex
  flex-wrap wrap
  gap 18px
  margin 0
  padding 0
  list-style none

  li
    font-size 12.5px
    color var(--text-muted, #6B7280)

    strong
      display block
      font-size 14px
      color inherit
      color var(--text-color, #1F2937)

// ---- Products -> Product -> Cross-sell: assignments ----------------------

.xs-assignment
  display flex
  align-items center
  gap 12px
  padding 12px 14px
  border 1px solid var(--border-color, #E9E9F4)
  border-radius var(--radius-md, 10px)

  & + .xs-assignment
    margin-top 8px

  &.is-off
    opacity .6

.xs-assignment-main
  flex 1 1 auto
  min-width 0

  strong
    display block
    font-size 13.5px

  small
    display block
    margin-top 2px
    font-size 12px
    color var(--text-muted, #6B7280)

.xs-assignment-actions
  display flex
  align-items center
  gap 8px
  flex 0 0 auto

// ---- the assign picker ---------------------------------------------------

.xs-option
  display flex
  align-items flex-start
  gap 12px
  padding 12px
  border 1px solid var(--border-color, #E9E9F4)
  border-radius var(--radius-md, 10px)
  cursor pointer

  & + .xs-option
    margin-top 8px

  &.is-picked
    border-color #333199
    background rgba(51, 49, 153, .05)

  &.is-taken
    opacity .55
    cursor not-allowed

  input[type="radio"]
    margin-top 3px

@media (max-width: 767px)
  .xs-form-grid
    grid-template-columns 1fr

  .xs-assignment
    flex-wrap wrap

  .xs-assignment-actions
    width 100%
    justify-content flex-end
