@import "variables.styl"

.order-cb
  display flex
  gap 15px
  flex-wrap wrap

  li
    display flex
    gap 10px

    input[type=checkbox]
      margin 0


// Shared container used by the message-detail page and the invoice/PDF layout
.order-wrapper
  max-width 1000px
  margin 0 auto
  background #fff

  .custom-dropdown
    .dropdown-wrapper
      left auto
      right 0

  table.shipping-table
    td
      vertical-align baseline
      border none

  table
    margin 15px 0

    td
      padding-top 15px
      padding-bottom 15px

    tr
      background none!important

    th
      border none
      color #fff
      background primary-color !important
      padding-top 10px
      padding-bottom 10px

  .order-details
    li
      display flex
      justify-content space-between

      & > span:first-child
        font-weight 500
        width 150px

      & > span:last-child
        width 160px

  .order-price
    li
      padding 10px 0
      border-bottom 1px solid #eee

      &:last-child
        border-bottom none

      span:first-child
        text-align right
        width 100px

      span:last-child
        text-align right
        width 80px

@media only screen and (max-width: 576px)
  .order-wrapper
    .title
      display block

      & > .dply-felx
        margin-top 5px
        justify-content left


// ==================== ORDER DETAIL PAGE ====================
.order-page
  max-width 1200px
  margin 0 auto
  background surface-color
  border 1px solid border-color
  border-radius var(--radius-lg)
  box-shadow 0 1px 2px shadow-color
  padding 24px

// ---- Header ----
.order-head
  display flex
  align-items flex-start
  justify-content space-between
  gap 16px
  flex-wrap wrap
  margin-bottom 22px

.order-breadcrumb
  display flex
  align-items center
  gap 8px
  font-size 13px
  color muted-color
  margin-bottom 10px

  a
    color primary-color
    font-weight 600

    &:hover
      text-decoration underline

  i
    font-size 10px
    color var(--text-soft)

.order-title-row
  display flex
  align-items center
  gap 12px
  flex-wrap wrap

  h4
    margin 0
    font-size 1.35rem
    font-weight 700
    color var(--text-strong)

.order-subtitle
  margin 8px 0 0
  font-size 13px
  color muted-color

.order-status-badge
  display inline-flex
  align-items center
  gap 6px
  padding 4px 12px
  border-radius 999px
  font-size 12px
  font-weight 650
  text-transform capitalize

  i
    font-size 9px

  &.is-warning
    color warning-foreground
    background warning-bg-color

  &.is-success
    color success-foreground
    background success-bg-color

  &.is-danger
    color danger-foreground
    background danger-bg-color

  &.is-info
    color info-foreground
    background info-bg-color

.order-head-actions
  display flex
  align-items center
  gap 10px
  flex-wrap wrap

// ---- Cards ----
.order-card
  background surface-color
  border 1px solid border-color
  border-radius var(--radius-lg)

.order-card-head
  display flex
  align-items center
  gap 10px
  padding 16px 20px
  font-size 15px
  font-weight 650
  color var(--text-strong)
  border-bottom 1px solid border-color

  i
    color primary-color
    font-size 15px

.order-card-body
  padding 20px

// ---- Customer & Shipping ----
.customer-body
  display flex
  gap 24px
  flex-wrap wrap

.customer-info
  flex 1 1 260px
  min-width 240px

.customer-name
  display block
  font-size 15px
  color var(--text-strong)
  margin-bottom 8px

.customer-address
  margin 0 0 12px
  line-height 1.6
  color font-color
  max-width 320px

.customer-contact
  display flex
  align-items center
  gap 10px
  margin 8px 0

  i
    width 16px
    text-align center
    color primary-color

  span
    color font-color

.customer-status
  flex 1 1 260px
  min-width 240px
  display flex
  flex-direction column
  gap 16px
  padding-left 24px
  border-left 1px solid border-color

.status-item
  display flex
  align-items center
  gap 12px

.status-icon
  display inline-flex
  align-items center
  justify-content center
  width 38px
  height 38px
  border-radius var(--radius-md)
  background primary-lite-color
  color primary-color
  font-size 15px
  flex-shrink 0

.status-text
  display flex
  flex-direction column
  gap 3px
  min-width 0

  .status-label
    font-size 12px
    color var(--text-soft)

  .status-value
    font-weight 600
    color var(--text-strong)

// ---- Order items table (edge to edge, fits without horizontal scroll) ----
.order-items-table
  // No sideways scroll; the fixed-layout rule further down divides the width.
  overflow-x visible

  table
    margin 0
    min-width 0
    // Fixed, so the columns share the page's width instead of each taking
    // what its content asks for. `auto` here is what let the table grow past
    // its own card and hide the line total behind a scrollbar.
    table-layout fixed
    width 100%

    th
      background primary-lite-color !important
      color muted-color
      border-bottom 1px solid border-color
      text-transform uppercase
      letter-spacing .02em
      font-size 11px
      white-space normal
      padding-left 8px
      padding-right 8px

    td
      padding 12px 8px
      white-space normal
      vertical-align top

    tr
      background none

    // The row thumbnail is a 44px identifier, not an illustration. It was
    // 100px, which set the row height and squeezed the product name into a
    // column two words wide.
    td img
      max-width 100%
      border-radius 6px
      object-fit contain

    .mr-20
      margin-right 12px

    .mn-w-200x
      min-width 0

    .mn-w-600x
      min-width 0

// ---- Timeline ----
.order-timeline
  display flex
  padding 6px 0

.timeline-step
  position relative
  flex 1 1 0
  display flex
  flex-direction column
  align-items center
  text-align center
  padding 0 4px

  &:not(:last-child)::after
    content ''
    position absolute
    top 21px
    left 50%
    width 100%
    height 2px
    background border-strong
    z-index 0

  &.is-done:not(:last-child)::after
    background success-foreground

.timeline-node
  position relative
  z-index 1
  display inline-flex
  align-items center
  justify-content center
  width 44px
  height 44px
  border-radius 50%
  border 2px solid border-strong
  background surface-color
  color var(--text-soft)
  font-size 15px

.timeline-label
  margin-top 10px
  font-size 13px
  font-weight 600
  color var(--text-strong)

.timeline-sub
  margin-top 2px
  font-size 12px
  color muted-color

.is-done
  .timeline-node
    border-color success-foreground
    background success-bg-color
    color success-foreground

.is-active
  .timeline-node
    border-color primary-color
    background primary-lite-color
    color primary-color

  .timeline-sub
    color primary-color
    font-weight 600

// ---- Order summary ----
.summary-row
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 8px 0
  font-size 14px

  & > span:first-child
    color muted-color

  & > span:last-child
    color var(--text-strong)
    font-weight 550
    text-align right

.summary-id
  display inline-flex
  align-items center
  gap 8px

.copy-btn
  border none
  background none
  cursor pointer
  color primary-color
  padding 2px
  font-size 13px
  line-height 1

  &:hover
    color primary-hover

.summary-divider
  height 0
  border-top 1px dashed border-strong
  margin 10px 0

// Money coming off the order: flash, loyalty and points summary rows.
.summary-credit
  color success-foreground
  font-weight 600

.free-badge
  padding 2px 10px
  border-radius 999px
  font-size 11px
  font-weight 650
  color success-foreground
  background success-bg-color
  text-transform uppercase

.summary-total-row
  padding-top 4px

  & > span:first-child
    font-size 15px
    font-weight 600
    color var(--text-strong)

.summary-total
  font-size 22px
  font-weight 700
  color primary-color !important

// ==================== ACCOUNT, ADDRESSES, AUDIT TRAIL ====================
// Added with the order-detail rework: the account panel, the second address
// block, and the status history below the progress strip.

// A one-word answer to "what is this customer entitled to", readable at a
// glance beside the name rather than buried in the account panel.
.account-pill
  display inline-flex
  align-items center
  padding 3px 10px
  border-radius 999px
  font-size 12px
  font-weight 600
  line-height 1.6
  background primary-lite-color
  color primary-color
  white-space nowrap

  &.is-personal, &.is-guest
    background var(--hover-color)
    color var(--text-soft)

  &.is-trade
    background rgba(16, 155, 105, 0.12)
    color #0f9b69

  &.is-muted
    background var(--hover-color)
    color var(--text-soft)
    font-weight 500

.customer-tags
  display flex
  flex-wrap wrap
  gap 8px
  margin 12px 0

.customer-link
  display inline-block
  margin-top 4px
  font-size 13px

.customer-guest
  display inline-block
  margin-top 4px
  font-size 13px
  color var(--text-soft)

// Where the account facts came from: the order, or the profile as it stands
// today. Quiet, because it qualifies the heading rather than competing with it.
.head-note
  margin-left auto
  font-size 12px
  font-weight 500
  color var(--text-soft)

// Label over value, wrapping into as many columns as the card can hold. A long
// company name or VAT number wraps inside its own cell instead of widening the
// card past the page.
.fact-grid
  display grid
  grid-template-columns repeat(auto-fit, minmax(190px, 1fr))
  gap 16px 24px
  margin 0

.fact
  min-width 0

  dt
    font-size 12px
    color var(--text-soft)
    margin-bottom 3px

  dd
    margin 0
    font-size 14px
    font-weight 600
    color var(--text-strong)
    overflow-wrap anywhere

.fact-muted
  font-weight 500
  color var(--text-soft)

// Delivery/collection beside billing, side by side while there is room.
.address-body
  display flex
  gap 24px
  flex-wrap wrap

.address-block
  flex 1 1 240px
  min-width 220px

.address-heading
  display block
  font-size 12px
  color var(--text-soft)
  margin-bottom 6px

// ---- Status history ----
.status-trail
  list-style none
  margin 0
  padding 0

  li
    position relative
    display flex
    gap 12px
    padding 0 0 18px 0

    // The rail joining one entry to the next, stopping at the last.
    &:not(:last-child)::before
      content ''
      position absolute
      left 5px
      top 14px
      bottom 0
      width 2px
      background border-color

    &:last-child
      padding-bottom 0

.trail-dot
  flex-shrink 0
  width 12px
  height 12px
  margin-top 4px
  border-radius 50%
  background primary-color
  z-index 1

.trail-body
  display flex
  flex-direction column
  gap 2px
  min-width 0

.trail-status
  font-size 14px
  font-weight 600
  color var(--text-strong)

.trail-meta
  font-size 12px
  color var(--text-soft)

.trail-note
  margin-top 4px
  font-size 13px
  color font-color
  overflow-wrap anywhere

.trail-empty
  margin 0
  font-size 13px
  color var(--text-soft)

// ---- Order list ----
// The customer's email under their name, so a row identifies the person
// without needing the detail page opened.
.row-sub
  display block
  font-size 11.5px
  color var(--text-soft)
  overflow hidden
  text-overflow ellipsis
  max-width 180px

.color-muted
  color var(--text-soft)

@media only screen and (max-width: 768px)
  .address-body
    gap 16px

  .address-block
    flex-basis 100%

  .fact-grid
    grid-template-columns 1fr
    gap 12px

  .head-note
    margin-left 0
    flex-basis 100%

  .order-card-head
    flex-wrap wrap

// ==================== RESPONSIVE ====================
@media only screen and (max-width: 768px)
  .customer-status
    padding-left 0
    border-left none
    padding-top 16px
    border-top 1px solid border-color

@media only screen and (max-width: 576px)
  .order-page
    padding 16px

  .order-head
    margin-bottom 16px

  .order-head-actions
    width 100%

  .order-timeline
    overflow-x auto

  .timeline-step
    min-width 116px

// ==================== ORDER DETAIL: OVERVIEW, STATES, ITEM CARDS ====================
// Added with the order-detail redesign. The page previously opened straight
// into the customer card, printed every figure at one weight, and pushed a
// nine-column item table sideways on anything narrower than a laptop.

// ---- Page states ----
// Loading, not found and error are three different answers; the page used to
// give all three as an empty shell.
.order-state
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 12px
  min-height 320px
  padding 48px 24px
  text-align center
  color var(--text-soft)

  h5
    margin 0
    font-size 18px
    color var(--text-strong)

  p
    margin 0
    max-width 44ch
    line-height 1.6

.order-state-icon
  font-size 40px
  line-height 1
  color var(--text-soft)

// ---- Header ----
.copy-btn
  display inline-flex
  align-items center
  justify-content center
  width 28px
  height 28px
  border none
  border-radius var(--radius-sm)
  background transparent
  color var(--text-soft)
  cursor pointer

  &:hover
    background var(--hover-color)
    color primary-color

// The confirmation after copying, so the click has an outcome.
.copy-flash
  display inline-block
  margin-top 6px
  font-size 12px
  font-weight 600
  color #0f9b69

.status-control
  display flex
  align-items center
  gap 10px
  flex-wrap wrap

// ---- Overview strip ----
// The eight facts that answer "what is this order" before any scrolling.
.order-overview
  display grid
  grid-template-columns repeat(auto-fit, minmax(150px, 1fr))
  gap 1px
  margin-bottom 20px
  background border-color
  border 1px solid border-color
  border-radius var(--radius-lg)
  overflow hidden

.ov-item
  display flex
  flex-direction column
  gap 4px
  padding 14px 16px
  background surface-color
  min-width 0

.ov-label
  font-size 11.5px
  font-weight 500
  letter-spacing 0.02em
  text-transform uppercase
  color var(--text-soft)

.ov-value
  font-size 14.5px
  font-weight 600
  color var(--text-strong)
  overflow-wrap anywhere

// The order number is a reference to read character by character.
.ov-mono
  font-family ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  font-size 13px

// The one figure on the strip anyone scans for.
.ov-total .ov-value
  font-size 17px
  color primary-color

// ---- Customer card ----
.customer-head
  display flex
  align-items flex-start
  justify-content space-between
  gap 16px
  flex-wrap wrap

.customer-identity
  display flex
  flex-direction column
  gap 3px
  min-width 0

.customer-meta
  font-size 12px
  color var(--text-soft)

// A secondary action: reachable, not competing with Update status.
.outline-btn.xs
  height 32px
  padding 0 14px
  font-size 13px

// ---- Addresses ----
.addr-heading
  font-size 12px
  font-weight 600
  letter-spacing 0.02em
  text-transform uppercase
  color var(--text-soft)
  margin-bottom 8px

.addr-block
  font-style normal
  line-height 1.7
  color font-color
  max-width 42ch

  b
    display block
    color var(--text-strong)

.addr-line
  display block
  overflow-wrap anywhere

.break-any
  overflow-wrap anywhere

.capitalise
  text-transform capitalize

// ---- Order items ----
// Numeric columns right-aligned so the figures line up down the column and a
// discount is visible without reading each row.
//
// No horizontal scroll, at any width. The table is fixed-layout at percentage
// widths, so the columns divide whatever space the page has rather than each
// claiming what its content wants - which is what made this table wider than
// its own card and pushed the line total off the right-hand edge behind a
// scrollbar.
.order-items-table
  overflow-x visible

  th.num, td.num
    text-align right
    white-space nowrap

.items-table
  table-layout fixed
  width 100%
  min-width 0

  th, td
    overflow-wrap anywhere

  // The only column allowed to take the slack; the rest are sized to their
  // longest realistic figure.
  .col-product
    width auto
    white-space normal

  .col-qty
    width 62px

  .col-unit
    width 132px

  .col-tax
    width 104px

  .col-total
    width 112px

// The card form of the same rows, for screens the table cannot fit.
.order-items-cards
  display none

.item-card
  padding 16px
  border-top 1px solid border-color

.item-card-head
  display flex
  gap 12px
  align-items flex-start

.item-card-img
  width 56px
  height 56px
  object-fit contain
  border 1px solid border-color
  border-radius var(--radius-sm)
  background #fff
  flex-shrink 0

.item-card-id
  display flex
  flex-direction column
  gap 2px
  min-width 0

  b
    color var(--text-strong)
    overflow-wrap anywhere

.item-sub
  font-size 12px
  color var(--text-soft)
  overflow-wrap anywhere

.item-card-prices
  margin 12px 0 0

  > div
    display flex
    align-items baseline
    justify-content space-between
    gap 12px
    padding 4px 0

  dt
    font-size 13px
    color var(--text-soft)

  dd
    margin 0
    font-size 13.5px
    font-weight 600
    color var(--text-strong)

.item-card-total
  margin-top 4px
  padding-top 8px !important
  border-top 1px solid border-color

  dd
    font-size 15px
    color primary-color

// ---- Payment / summary ----
.summary-note
  display block
  font-size 11.5px
  font-weight 500
  color var(--text-soft)

.control-cell
  min-width 0

// Says out loud why an unpaid cash order is not a problem.
.pay-note
  display flex
  align-items flex-start
  margin 14px 0 0
  padding 10px 12px
  border-radius var(--radius-md)
  background primary-lite-color
  font-size 12.5px
  line-height 1.5
  color primary-color

  i
    margin-top 2px

@media only screen and (max-width: 992px)
  .order-overview
    grid-template-columns repeat(auto-fit, minmax(140px, 1fr))

@media only screen and (max-width: 768px)
  // Nine columns do not fit a phone; the same rows read as cards instead of
  // as a sideways scroll that hides the prices.
  .order-items-table
    display none

  .order-items-cards
    display block

  .order-head-actions
    flex-wrap wrap

  .status-control
    width 100%

  .customer-head
    flex-direction column
    align-items stretch

@media only screen and (max-width: 576px)
  .order-overview
    grid-template-columns 1fr 1fr

  .ov-item
    padding 12px 14px

  .ov-value
    font-size 13.5px

  .ov-total .ov-value
    font-size 15.5px

  .order-title-row
    flex-wrap wrap

  // A horizontal timeline cannot show five stages on a phone, so it becomes a
  // vertical one rather than a strip that scrolls sideways.
  .order-timeline
    flex-direction column
    align-items stretch
    gap 0
    overflow-x visible

    &::before, &::after
      display none

  .timeline-step
    display grid
    grid-template-columns 36px 1fr
    grid-template-areas "node label" "node sub"
    align-items center
    gap 0 12px
    min-width 0
    padding 10px 0
    text-align left
    position relative

    // The rail joining one stage to the next.
    &:not(:last-child)::after
      content ''
      position absolute
      left 17px
      top 46px
      bottom -10px
      width 2px
      background border-color

  .timeline-node
    grid-area node
    margin 0

  .timeline-label
    grid-area label
    text-align left

  .timeline-sub
    grid-area sub
    text-align left

// ==================== FULL-WIDTH SECTIONS ====================
// The item table is the widest thing on this page - a product, its variant and
// five figures - and it was the one section squeezed into the column that
// shares its width with the rail. Everything else here is label-and-value
// pairs that read perfectly well in half the width, so the items get the page
// and the rest keeps the two columns.
.order-full
  margin-bottom 20px

  // The five columns now divide the whole page rather than two thirds of it,
  // so the product cell has room for a full product name on one line.
  .items-table
    .col-qty
      width 80px

    .col-unit
      width 150px

    .col-tax
      width 120px

    .col-total
      width 130px

@media only screen and (max-width: 992px)
  .order-full
    margin-bottom 16px

// ==================== ROWS OF CARDS ====================
// The two-column grid is gone.
//
// A rail forced every section into one of two fixed widths and left whichever
// column ran out of content first sitting empty beside the other - which is
// what put a tall blank strip next to the item table. Rows instead: each row
// takes the page and divides it between however many cards it holds, so
// nothing is squeezed and nothing is stranded.
//
// auto-fit means the same markup is three-up on a desktop, two-up on a tablet
// and one-up on a phone with no breakpoint of its own.
.order-row
  display grid
  grid-template-columns repeat(auto-fit, minmax(280px, 1fr))
  gap 20px
  margin-bottom 20px
  // Equal heights, so a row of cards reads as one band rather than three
  // pieces of ragged paper.
  align-items stretch

  > .order-card
    min-width 0

@media only screen and (max-width: 992px)
  .order-row
    gap 16px
    margin-bottom 16px

@media only screen and (max-width: 576px)
  .order-row
    grid-template-columns 1fr

// ---- Shipment tracking (AfterShip), inside the Fulfilment card ----
// Every rule is under .shipment-block so nothing here reaches another form.
.shipment-block
  .fact-grid
    margin-top 4px

  .shipment-form
    display flex
    flex-wrap wrap
    align-items center
    gap 10px
    margin-top 14px

  .shipment-input
    flex 1 1 180px
    min-width 0
    height btn-height
    line-height normal
    padding 0 12px
    font-size 14px
    color var(--text-strong)
    background surface-color
    border 1px solid border-color
    border-radius var(--radius-md, 8px)

    &:focus
      outline none
      border-color primary-color
      box-shadow 0 0 0 3px var(--primary-soft)

  .shipment-hint
    margin 8px 0 0
    font-size 12px
    color var(--text-soft)

  .shipment-notice
    margin 10px 0 0
    font-size 13px
    font-weight 500
    color success-foreground

  .shipment-error
    margin 10px 0 0
    padding 8px 10px
    font-size 13px
    color danger-foreground
    background danger-bg-color
    border-radius var(--radius-md, 8px)

  // Searchable courier picker (AfterShip's list).
  .courier-picker
    position relative
    flex 1 1 220px
    min-width 0

    .shipment-input
      width 100%

  .courier-list
    position absolute
    z-index 30
    top calc(100% + 4px)
    left 0
    right 0
    max-height 280px
    overflow-y auto
    margin 0
    padding 4px 0
    list-style none
    background surface-color
    border 1px solid border-color
    border-radius var(--radius-md, 8px)
    box-shadow 0 8px 24px rgba(15, 23, 42, .12)

  .courier-group
    padding 6px 12px 4px
    font-size 11px
    font-weight 600
    letter-spacing .04em
    text-transform uppercase
    color var(--text-soft)

  .courier-option
    display flex
    flex-direction column
    gap 1px
    padding 7px 12px
    cursor pointer

    &:hover, &.is-selected
      background var(--primary-soft)

  .courier-name
    font-size 14px
    font-weight 600
    color var(--text-strong)

  .courier-meta
    font-size 12px
    color var(--text-soft)

  .courier-note
    padding 8px 12px
    font-size 13px
    color var(--text-soft)

    &.is-error
      color danger-foreground

  .courier-fields
    display grid
    grid-template-columns repeat(auto-fit, minmax(200px, 1fr))
    gap 10px 16px
    margin-top 12px

  .courier-field
    display flex
    flex-direction column
    gap 4px
    font-size 12px
    color var(--text-soft)

  .courier-source a
    color primary-color
    font-weight 600

  .shipment-attention
    display flex
    gap 8px
    align-items flex-start
    margin 12px 0 0
    padding 10px 12px
    font-size 13px
    line-height 1.45
    color warning-foreground
    background warning-bg-color
    border-radius var(--radius-md, 8px)

  .shipment-tag-Delivered
    color success-foreground

  .shipment-tag-Exception, .shipment-tag-AttemptFail, .shipment-tag-Expired
    color danger-foreground

@media (max-width: 575px)
  .shipment-block .shipment-form > *
    flex 1 1 100%

// ---- Shipment tracking, 2026-10-19 layout: summary card + form on demand ----
.shipment-block
  margin-top 18px
  padding-top 16px
  border-top 1px solid border-color

  .ship-head
    display flex
    align-items center
    justify-content space-between
    gap 10px
    margin-bottom 10px

    .addr-heading
      margin 0

  .ship-pill
    flex-shrink 0
    padding 3px 10px
    border-radius 999px
    font-size 12px
    font-weight 600
    white-space nowrap

  .ship-pill-info
    color primary-color
    background var(--primary-soft)

  .ship-pill-good
    color success-foreground
    background success-bg-color

  .ship-pill-warn
    color warning-foreground
    background warning-bg-color

  .ship-pill-bad
    color danger-foreground
    background danger-bg-color

  .ship-pill-muted
    color var(--text-soft)
    background var(--hover-color, #f1f2f6)

  .ship-card
    padding 14px
    border 1px solid border-color
    border-radius var(--radius-md, 8px)
    background var(--surface-soft, rgba(0, 0, 0, .015))

  .ship-card-top
    display flex
    align-items flex-start
    justify-content space-between
    gap 10px

  .ship-ident
    display flex
    flex-direction column
    gap 2px
    min-width 0

  .ship-courier
    font-size 13px
    color var(--text-soft)

  .ship-number
    display inline-flex
    align-items center
    gap 6px
    font-size 16px
    font-weight 700
    letter-spacing .02em
    color var(--text-strong)
    font-variant-numeric tabular-nums
    overflow-wrap anywhere

  button.ship-icon-btn
    display inline-flex
    align-items center
    justify-content center
    width 26px
    height 26px !important
    line-height 26px !important
    padding 0
    font-size 13px
    color var(--text-soft)
    background transparent !important
    border 0
    border-radius 6px
    cursor pointer

    &:hover
      color primary-color
      background var(--primary-soft) !important

  .ship-track-link
    flex-shrink 0
    font-size 13px
    font-weight 600
    color primary-color
    white-space nowrap

    i
      font-size 11px
      margin-left 3px

  .ship-detail
    margin 8px 0 0
    font-size 13px
    color var(--text-strong)

  .ship-meta
    display flex
    flex-wrap wrap
    gap 4px 16px
    margin 10px 0 0
    padding 0
    list-style none
    font-size 12px
    color var(--text-soft)

    i
      margin-right 4px

    b
      color var(--text-strong)
      font-weight 600

  .ship-card-actions
    display flex
    flex-wrap wrap
    gap 8px
    margin-top 12px

    .outline-btn
      padding 0 12px

  .ship-form
    display flex
    flex-direction column
    gap 12px

  .ship-field
    display flex
    flex-direction column
    gap 5px
    min-width 0

  .ship-label
    font-size 12px
    font-weight 600
    color var(--text-soft)

  .courier-picker
    flex none
    width 100%

    .shipment-input
      padding-left 34px

    .shipment-input.has-value::placeholder
      color var(--text-strong)
      opacity 1
      font-weight 600

  .courier-picker-icon
    position absolute
    left 12px
    top 50%
    transform translateY(-50%)
    font-size 13px
    color var(--text-soft)
    pointer-events none

  .courier-foot
    margin-top 4px
    padding 8px 12px 6px
    font-size 12px
    color var(--text-soft)
    border-top 1px solid border-color

    a
      color primary-color
      font-weight 600

  .courier-fields
    margin-top 0

  .ship-form-actions
    display flex
    flex-wrap wrap
    gap 8px

    .primary-btn, .outline-btn
      padding 0 18px

  .shipment-notice
    display flex
    gap 8px
    align-items flex-start

  .shipment-attention span, .shipment-notice span
    flex 1

// One height and type size for every control in the form row: the inputs are
// 40px, and the global outline/ajax button rules otherwise land these at 34px.
.shipment-block .ship-form-actions .outline-btn,
.shipment-block .ship-form-actions .primary-btn
  height 40px !important
  line-height 38px !important
  font-size 14px !important
  font-weight 600 !important

.shipment-block .ship-form-actions .primary-btn
  line-height 40px !important

.shipment-block .ship-card-actions .outline-btn
  font-size 13px !important
  font-weight 600 !important

// Inputs stacked under a label (tracking number, courier extra fields) keep
// the normal control height. The base rule above gives .shipment-input
// `flex 1 1 180px` for sitting in a row; inside a column that same basis
// becomes 180px of HEIGHT, which made the tracking number box ~180px tall.
.shipment-block .ship-field > .shipment-input
  flex none
  width 100%
  height btn-height
