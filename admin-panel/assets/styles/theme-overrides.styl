@import "./variables.styl"

.tab-sidebar
.detail-width
.form-wrapper
.list-page-body
  max-width 100%

.tab-sidebar > .title
  padding 20px
  font-size 1.15rem
  font-weight 650
  color var(--text-strong)

.search-input
  min-width 240px

  input
    background surface-color
    border-color border-strong
    height 36px
    line-height 34px

.dropdown-inner
.custom-dropdown
.inline-pop-over
.pop-content
  background surface-color
  border-color border-color
  box-shadow none

.dropdown-inner button:hover
.custom-dropdown button:hover
  background hover-color

.modal
.popup
.dialog
  background surface-color
  color font-color

.badge
.chip
.status span
.voucher-type
  border-radius 999px

.form-wrapper .dply-felx.inputs
  flex-wrap wrap

.form-wrapper .input-wrapper
  min-width 220px
  margin-bottom 12px

.form-wrapper .input-wrapper input
.form-wrapper .input-wrapper textarea
  max-width 100%

.danger-msg p
.success-msg p
.warning-msg p
.info-msg p
  margin-top 4px
  line-height 1.5

.Vue-Toastification__toast
  border-radius var(--radius-md)

@media only screen and (max-width: 768px)
  .tab-sidebar > .title
    padding 4px 2px 10px

  .search-input
    min-width 100%

  .table-wrapper
    max-width calc(100vw - 24px)

  .form-wrapper .input-wrapper
    min-width 100%

  .single-btn
    gap 10px

    .primary-btn
      flex 1 1 150px

.align-start.dply-felx.reverse.block-md.gap-10.p-20
  padding 0 0 12px !important
  align-items center

.list-page-body.p-20
  padding 0 !important

.list-summary
  padding 0 2px

.list-summary h5
  font-size 13px
  font-weight 500
  color muted-color

.form-wrapper
  background surface-color
  box-shadow none

.input-wrapper label
  font-weight 550

.button.lite-btn
.lite-btn
.outline-btn:not(.disabled)
  height 34px
  line-height 32px
  border-radius var(--radius-md)

.delete-btn
  background var(--danger-bg)
  color var(--danger-text)

.empty-state
  border 1px dashed border-strong
  background surface-color
