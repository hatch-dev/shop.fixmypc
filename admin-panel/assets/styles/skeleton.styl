// Placeholder used by components/SkeletonBlock.vue while dashboard data loads.
//
// Colours come from the theme variables so the placeholder stays legible if the
// panel is ever themed; the sweep is a pseudo-element so the base block keeps
// whatever width/height/radius the caller passed inline.

.skeleton-block
  display block
  position relative
  overflow hidden
  flex none
  background var(--hover-color)
  border 1px solid transparent

  &:after
    content ''
    position absolute
    top 0
    right 0
    bottom 0
    left 0
    transform translateX(-100%)
    background-image linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0,
      rgba(255, 255, 255, .45) 45%,
      rgba(255, 255, 255, .75) 60%,
      rgba(255, 255, 255, 0) 100%
    )
    animation skeleton-sweep 1.35s ease-in-out infinite

  &--circle
    border-radius 50%

// A row of placeholders that should read as one line of content.
.skeleton-line
  display flex
  align-items center
  gap 12px

.skeleton-stack
  display flex
  flex-direction column
  gap 6px
  flex 1
  min-width 0

@keyframes skeleton-sweep
  100%
    transform translateX(100%)

// Respect a reduced-motion preference: keep the placeholder, drop the sweep.
@media (prefers-reduced-motion: reduce)
  .skeleton-block:after
    animation none
